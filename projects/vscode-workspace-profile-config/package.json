        "title": "ExtProfileLock: Sync Pro Workspace & Interpolate Env"
      },
      {
        "command": "extProfileLock.activateLicense",
        "title": "ExtProfileLock: Activate Pro License"
      }
    ]
  },
  "scripts": {
    "test": "python3 tests/smoke_test.py"
  }
}
