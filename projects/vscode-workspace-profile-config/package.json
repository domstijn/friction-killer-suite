{
  "name": "vscode-workspace-profile-config",
  "displayName": "ExtProfileLock",
  "publisher": "friction-killer",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "type": "module",
  "main": "./src/index.js",
  "contributes": {
    "commands": [
      {
        "command": "extProfileLock.auditWorkspace",
        "title": "ExtProfileLock: Audit Workspace Profile"
