{
  "name": "vscode-workspace-profile-config",
  "displayName": "ExtProfileLock",
  "publisher": "friction-killer",
  "version": "0.1.1",
  "description": "Enforce repo-level VS Code extension locks, interpolate .env variables into .code-workspace files, and eliminate profile drift.",
  "homepage": "https://domstijn.github.io/friction-killer-suite/products/vscode-workspace-profile-config/",
  "repository": {
    "type": "git",
    "url": "https://github.com/domstijn/friction-killer-suite.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "type": "module",
  "main": "./src/index.js",
  "contributes": {
    "commands": [
      {
        "command": "extProfileLock.auditWorkspace",
        "title": "ExtProfileLock: Audit Workspace Profile"
      },
      {
        "command": "extProfileLock.syncProWorkspace",
        "title": "ExtProfileLock: Sync Pro Workspace & Interpolate Env"
      },
      {
        "command": "extProfileLock.activateLicense",
        "title": "ExtProfileLock: Activate Pro License"
      }
    ]
  },
  "scripts": {
    "test": "python3 tests/smoke_test.py"
  }
}
